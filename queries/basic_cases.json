  },
  {
    "id": "fund-holdings",
    "question": "top 5 holdings of hdfc large cap fund",
    "expect": {"fields": ["holdings"], "sections": ["holdings"]}
  },
  {
    "id": "fund-sectors",
    "question": "how much of hdfc large cap is in banks",
    "expect": {"fields": ["sector_lookup"], "sections": ["sectors"]}
  },
  {
    "id": "fund-benchmark",
    "question": "is hdfc large cap beating its benchmark",
    "expect": {"fields": ["vs_benchmark"], "modules": ["vs_benchmark"]}
  },
  {
    "id": "benchmark-return-1y",
