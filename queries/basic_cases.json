    "expect_turns": [
      {"fields": ["aum"]},
      {"fields": ["aum", "expense_ratio"]}
    ]
  },
  {
    "id": "fund-exit-load",
    "question": "what is the exit load of hdfc large cap fund",
    "expect": {"fields": ["exit_load"], "modules": ["snapshot"]}
  },
  {
    "id": "fund-returns",
    "question": "what is the 1 month and 1 year return of hdfc large cap fund",
