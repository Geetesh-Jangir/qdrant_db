# Copy to .env on your machine or Lightsail (/opt/news-rag/.env). Never commit real keys.

QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=news_articles

# Primary: Anthropic Claude Haiku 5.5 (fallback: Gemini when primary fails)
RAG_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Fallback (keep configured when using anthropic primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_COMPOSER_MODEL=gemini-2.5-flash-lite

# Optional instead of Anthropic/Gemini:
# RAG_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Optional on a public URL (browser sends X-App-Token header)
# APP_TOKEN=

# Investor portfolio Q&A (optional — set CRN only; fetches workspace for this client)
# CLIENT_REF_NO=CRN-your-client-id
# Defaults shown in the chat CRN picker (the picker, not this file, chooses the active book)
# DEFAULT_CRN_UJJWAL=
# DEFAULT_CRN_MOHIT=
# RUPEESTOP_BACKEND_BASE=https://backend.rupeestop.com
# RUPEESTOP_AUTH_TOKEN=   # Bearer for /api/v1/admin/* (rs-rating, drawdown, workspace, …)
# RUPEESTOP_ADMIN_TOKEN=  # legacy alias if RUPEESTOP_AUTH_TOKEN is unset
# RUPEESTOP_ADMIN_USERNAME=   # optional: auto-refresh token via POST /api/v1/user/admin-login when JWT expires
# RUPEESTOP_ADMIN_PASSWORD=
# PORTFOLIO_FIXTURE_PATH=data/workspace_sample.json   # optional override for offline portfolio Q&A

# India 24K gold (INR per 10g). Public endpoint; no key required.
# GOLD_PRICE_API_URL=https://backend.rupeestop.com/api/v1/app/market/gold-price
# Silver price feed is not wired yet. Leave empty so silver questions use news only.
# SILVER_PRICE_API_URL=

PYTHONPATH=.
