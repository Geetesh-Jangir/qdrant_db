# Copy to .env on your machine or Lightsail (/opt/news-rag/.env). Never commit real keys.

QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=news_articles

RAG_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional instead of Gemini:
# RAG_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Optional on a public URL (browser sends X-App-Token header)
# APP_TOKEN=

PYTHONPATH=.
EMBEDDING_CACHE_DIR=data/embedding_models

# Optional Hugging Face token if model download is rate-limited
# HUGGINGFACE_TOKEN=

# --- News pipeline / historical backfill (GitHub Actions or VM) ---
# JEV_BASE_URL=
# JEV_API_KEY=
# NEWS_DATE_RANGE=1/10/2026-2/10/2026
# NEWS_RUN_SUBDIR=2026-10-01
# BACKFILL_START=1/10/2026
# BACKFILL_END=3/10/2026
# BACKFILL_PAUSE_SEC=600
# HOLDINGS_LIMIT=500
# SECTORS_LIMIT=50
# NEWS_CORPUS_MODE=true
# RETENTION_DAYS=0
# SCRAPE_DOMAIN_GAP_SEC=0.5
