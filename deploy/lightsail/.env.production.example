# Copy to /opt/news-rag/.env on the Lightsail instance (never commit real values).

QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=news_articles

RAG_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional instead of Gemini:
# RAG_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Recommended on a public URL (browser must send X-App-Token — see deploy docs)
# APP_TOKEN=

# Insights. Haiku only; no Gemini/DeepSeek fallback. Set INSIGHTS_PUBLIC=false to hide the API
# behind INSIGHTS_ADMIN_TOKEN while you review. INSIGHTS_ALLOW_GENERATE=false hides the button.
INSIGHTS_LLM_MODEL=claude-haiku-5-5
INSIGHTS_LLM_PROVIDER=anthropic
# INSIGHTS_PUBLIC=true
# INSIGHTS_ADMIN_TOKEN=
# INSIGHTS_ALLOW_GENERATE=true
# INSIGHTS_FAILURE_WEBHOOK_URL=

# GOLD_PRICE_API_URL=https://backend.rupeestop.com/api/v1/app/market/gold-price
# SILVER_PRICE_API_URL=

PYTHONPATH=/opt/news-rag
EMBEDDING_CACHE_DIR=data/embedding_models

# Daily news ingest (run-daily-pipeline.sh sets defaults; override here if needed)
# HOLDINGS_LIMIT=250
# FETCH_WORKERS=1
# SCRAPE_WORKERS=2
# SCRAPE_DOMAIN_GAP_SEC=1.5
# GOOGLE_HTTP_PROXY=http://user:pass@host:port
