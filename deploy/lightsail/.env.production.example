# Copy to /opt/news-rag/.env on the Lightsail instance (never commit real values).

QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=news_articles

RAG_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional instead of Gemini:
# RAG_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Recommended on a public URL (browser must send X-App-Token — see deploy docs)
# APP_TOKEN=

PYTHONPATH=/opt/news-rag
EMBEDDING_CACHE_DIR=data/embedding_models
