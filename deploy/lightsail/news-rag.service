# Install: sudo cp deploy/lightsail/news-rag.service /etc/systemd/system/
# Edit User, WorkingDirectory, and port if needed, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now news-rag

[Unit]
Description=News RAG (FastAPI / uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/news-rag
Environment=PYTHONPATH=/opt/news-rag
Environment=MALLOC_ARENA_MAX=2
EnvironmentFile=-/opt/news-rag/.env
ExecStart=/opt/news-rag/.venv/bin/uvicorn news_rag.app:app --host 127.0.0.1 --port 8081
TimeoutStartSec=300
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
